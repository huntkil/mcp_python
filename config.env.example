# MCP Server Configuration Example
# 이 파일을 config.env로 복사하고 실제 경로로 수정하세요.

# 프로젝트 기본 경로 (현재 디렉토리)
MARKDOWN_MCP_BASE_PATH=/Users/username/Desktop/mcp_python

# Obsidian 볼트 경로 (실제 볼트 경로로 수정)
OBSIDIAN_VAULT_PATH="/Users/username/Library/Mobile Documents/iCloud~md~obsidian/Documents/My Vault"

# 로그 레벨 설정 (선택사항)
# LOG_LEVEL=INFO

# 디버그 모드 (선택사항)
# DEBUG_MODE=false

# ===========================================
# Windows 예시:
# MARKDOWN_MCP_BASE_PATH=C:\Users\username\Desktop\mcp_python
# OBSIDIAN_VAULT_PATH="C:\Users\username\Documents\Obsidian\My Vault"

# Linux 예시:
# MARKDOWN_MCP_BASE_PATH=/home/username/Desktop/mcp_python
# OBSIDIAN_VAULT_PATH="/home/username/Documents/Obsidian/My Vault"
# =========================================== 